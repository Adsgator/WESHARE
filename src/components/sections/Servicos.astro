---
import { Icon } from "astro-icon/components";

const WA_URL =
  "https://wa.me/5512982710971?text=Ol%C3%A1!%20Vi%20o%20site%20e%20quero%20saber%20mais.";

const servicos = [
  {
    nome: "Endereço Fiscal e Comercial",
    descricao:
      "Documentação liberada no mesmo dia para abertura ou transferência de CNPJ, com gestão de correspondência inclusa.",
    precoResumo: "R$ 119,90 / mês",
    destaque: "Mais contratado",
    tone: "dark",
  },
  {
    nome: "Escritório Privativo",
    descricao:
      "Sala planejada para atender clientes ou trabalhar sozinho com total privacidade, com ambiente climatizado, café expresso, água mineral e impressora colorida inclusos.",
    precoResumo: "a partir de R$ 50 / hora",
    tone: "light",
  },
  {
    nome: "Sala de Reunião",
    descricao:
      "Espaço para até 7 pessoas com smart TV, flip-chart, iluminação natural e a sobriedade certa para negociações importantes.",
    precoResumo: "a partir de R$ 80 / hora",
    tone: "light-soft",
  },
  {
    nome: "Escritório Compartilhado",
    descricao:
      "Três estações de trabalho em ambiente climatizado, com café expresso, água mineral, impressora colorida e Wi-Fi de qualidade, tudo incluso na reserva.",
    precoResumo: "a partir de R$ 90 / diária",
    tone: "light",
  },
];
---

<section id="servicos" class="section-py bg-background">
  <div class="container-wide">
    <div class="max-w-[42rem]">
      <span class="label-tag mb-5" data-animate>Serviços</span>
      <h2 class="font-serif text-display-lg text-text-main" data-animate>
        O espaço certo para cada momento do seu negócio
      </h2>
      <p class="mt-4 max-w-[34rem] text-body-lg text-text-soft" data-animate>
        De um endereço fiscal com prestígio a uma sala para a reunião mais importante do mês.
        Tudo no mesmo lugar, com atendimento ágil e estrutura pronta para uso.
      </p>
    </div>

    <div class="mt-8 grid gap-px overflow-hidden border border-border sm:grid-cols-2 lg:grid-cols-4" data-animate-group>
      {servicos.map((servico) => (
        <article
          class:list={[
            "flex min-h-[18rem] flex-col justify-between p-7",
            servico.tone === "dark" ? "bg-dark text-white" : "text-text-main",
            servico.tone === "light" ? "bg-surface-alt" : "",
          ]}
          style={servico.tone === "light-soft" ? "background: color-mix(in srgb, var(--t-surface-alt) 65%, var(--t-surface) 35%);" : undefined}
          data-animate-item
        >
          <div>
            <div class="flex items-start justify-between gap-4">
              <h3 class:list={["font-serif text-display-sm", servico.tone === "dark" ? "text-white" : "text-text-main"]}>
                {servico.nome}
              </h3>
              {servico.destaque && (
                <span class="border border-primary/30 bg-primary/8 px-2.5 py-1 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-primary">
                  {servico.destaque}
                </span>
              )}
            </div>

            <p class:list={["mt-4 max-w-[18rem] text-body-md", servico.tone === "dark" ? "text-white/72" : "text-text-soft"]}>
              {servico.descricao}
            </p>
          </div>

          <div class="mt-7">
            <div class:list={["h-px", servico.tone === "dark" ? "bg-white/15" : "bg-border"]}></div>

            <p class:list={[
              "mt-4 text-[0.72rem] font-semibold uppercase tracking-[0.13em]",
              servico.tone === "dark" ? "text-white/80" : "text-primary",
            ]}>
              {servico.precoResumo}
            </p>

            <a
              href={WA_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-tracking="click-whatsapp-servico"
              data-section={servico.nome}
              class:list={["link-arrow mt-4", servico.tone === "dark" ? "text-white" : "text-text-main"]}
            >
              Falar no WhatsApp
              <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
