---
import { Icon } from "astro-icon/components";

const WA_URL =
  "https://wa.me/5512982710971?text=Ol%C3%A1!%20Vi%20o%20site%20e%20quero%20saber%20mais.";

const WA_URL_PLANO =
  "https://wa.me/5512982710971?text=Ol%C3%A1!%20Quero%20montar%20um%20plano%20sob%20medida.";

const planos = [
  {
    nome: "Endereço Fiscal e Comercial",
    precos: [{ valor: "R$ 119,90", unidade: "por mês" }],
    descricao:
      "Documentação imediata para abertura ou transferência de CNPJ, gestão de correspondência inclusa e 20% de desconto em reservas de sala.",
    faixa: "Plano principal",
    tone: "dark",
  },
  {
    nome: "Escritório Privativo",
    precos: [
      { valor: "R$ 50", unidade: "hora" },
      { valor: "R$ 180", unidade: "diária" },
      { valor: "R$ 2.200", unidade: "mês" },
    ],
    descricao:
      "Sala reservada para atendimento individual, foco e reuniões privadas, com café expresso, água mineral e impressora colorida inclusos.",
    faixa: "Atendimento privativo",
    tone: "light",
  },
  {
    nome: "Sala de Reunião",
    precos: [
      { valor: "R$ 80", unidade: "hora" },
      { valor: "R$ 280", unidade: "diária livre" },
      { valor: "R$ 3.500", unidade: "mês" },
    ],
    descricao:
      "Espaço para até 7 pessoas com smart TV, flip-chart, iluminação natural e o acabamento certo para negociações importantes.",
    faixa: "Reuniões e apresentações",
    tone: "light-dark",
  },
  {
    nome: "Escritório Compartilhado",
    precos: [
      { valor: "R$ 90", unidade: "diária" },
      { valor: "R$ 750", unidade: "mês" },
    ],
    descricao:
      "Três estações de trabalho em ambiente climatizado, com infraestrutura pronta para quem precisa produzir sem custo fixo alto.",
    faixa: "Uso flexível",
    tone: "light-soft",
  },
];
---

<section id="precos" class="section-py bg-background">
  <div class="container-wide">
    <div class="max-w-[42rem]">
      <span class="label-tag mb-5" data-animate>Preços</span>
      <h2 class="font-serif text-display-lg text-text-main" data-animate>
        Um endereço de prestígio por menos do que você imagina
      </h2>
      <p class="mt-4 max-w-[35rem] text-body-lg text-text-soft" data-animate>
        Sem prazo de fidelidade e com toda a estrutura essencial para manter seu CNPJ em ordem e atender bem quando precisar.
      </p>
    </div>

    <div class="mt-8 flex flex-col gap-2.5" data-animate-group>
      {planos.map((plano) => (
        <article
          class:list={[
            "border border-border",
            plano.tone === "light" ? "bg-surface-alt text-text-main" : "",
            plano.tone === "dark" ? "bg-dark text-white" : "",
          ]}
          style={
            plano.tone === "light-soft"
              ? "background: color-mix(in srgb, var(--t-surface-alt) 70%, var(--t-surface) 30%);"
              : plano.tone === "light-dark"
                ? "background: color-mix(in srgb, var(--t-dark) 14%, var(--t-surface) 86%);"
                : undefined
          }
          data-animate-item
        >
          <div class="grid gap-4 px-5 py-6 lg:grid-cols-[19rem_1px_minmax(0,1fr)_auto] lg:items-center lg:gap-5 lg:px-7">
            <div>
              <p class:list={["text-[0.72rem] font-semibold uppercase tracking-[0.16em]", plano.tone === "dark" ? "text-white/70" : "text-primary"]}>
                {plano.nome}
              </p>

              {plano.precos.length === 1 ? (
                plano.precos.map((preco) => (
                  <div class="mt-3">
                    <p class:list={["font-serif text-display-md", plano.tone === "dark" ? "text-white" : "text-text-main"]}>
                      {preco.valor}
                    </p>
                    <p class:list={["mt-1 text-[0.78rem] font-medium uppercase tracking-[0.14em]", plano.tone === "dark" ? "text-white/55" : "text-text-muted"]}>
                      {preco.unidade}
                    </p>
                  </div>
                ))
              ) : (
                <div class="mt-3 flex flex-wrap gap-2">
                  {plano.precos.map((preco) => (
                    <div class:list={[
                      "border px-3 py-2",
                      plano.tone === "dark" ? "border-white/18 bg-white/8" : "border-border bg-background",
                    ]}>
                      <p class:list={["font-serif text-[1.15rem] leading-none", plano.tone === "dark" ? "text-white" : "text-text-main"]}>
                        {preco.valor}
                      </p>
                      <p class:list={["mt-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.13em]", plano.tone === "dark" ? "text-white/55" : "text-text-muted"]}>
                        {preco.unidade}
                      </p>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div class:list={["hidden h-full lg:block", plano.tone === "dark" ? "bg-white/15" : "bg-border"]}></div>

            <div>
              <p class:list={["text-[0.72rem] font-semibold uppercase tracking-[0.16em]", plano.tone === "dark" ? "text-white/70" : "text-primary"]}>
                {plano.faixa}
              </p>
              <p class:list={["mt-2.5 max-w-[31rem] text-body-md", plano.tone === "dark" ? "text-white/74" : "text-text-soft"]}>
                {plano.descricao}
              </p>
            </div>

            <a
              href={WA_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-tracking="click-whatsapp-precos"
              data-section={plano.nome}
              class:list={[
                "link-arrow justify-self-start pt-1 lg:justify-self-end lg:pt-0",
                plano.tone === "dark" ? "text-white" : "text-text-main",
              ]}
            >
              Falar agora
              <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
            </a>
          </div>
        </article>
      ))}

      <div class="flex flex-col gap-5 border border-border bg-surface-alt px-5 py-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-7" data-animate-item>
        <div>
          <span class="label-tag mb-3">Plano sob medida</span>
          <h3 class="font-serif text-display-sm text-text-main">
            Usa o espaço toda semana? O valor da diária cai.
          </h3>
          <p class="mt-2.5 max-w-[38rem] text-body-md text-text-soft">
            Montamos um plano com a frequência que você precisa — 1x, 2x ou 3x por semana.
            Quanto maior a recorrência, menor o valor da diária. Os planos mensais dão uso
            exclusivo do espaço, 24 horas por dia, 7 dias por semana.
          </p>
        </div>

        <a
          href={WA_URL_PLANO}
          target="_blank"
          rel="noopener noreferrer"
          data-tracking="click-whatsapp-plano-sob-medida"
          data-section="plano-sob-medida"
          class="btn-primary flex-shrink-0"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" />
          Montar meu plano
        </a>
      </div>
    </div>

    <p class="mt-5 text-body-sm text-text-muted" data-animate>
      Valores de referência. Confirme a disponibilidade da data pelo WhatsApp.
    </p>
  </div>
</section>
