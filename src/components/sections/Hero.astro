---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroPrincipal from "../../assets/images/hero_principal_webp.webp";

const WA_URL =
  "https://wa.me/5512982710971?text=Ol%C3%A1!%20Vi%20o%20site%20e%20quero%20saber%20mais.";

const destaquesPreco = ["Documentação no mesmo dia", "Sem fidelidade", "Correspondência inclusa"];
---

<section id="hero-section" class="section-py relative overflow-hidden bg-primary">
  <div class="hero-grid absolute inset-0"></div>
  <div class="container-wide relative z-10">
    <div class="grid gap-7">
      <div class="max-w-[44rem]">
        <span class="mb-5 inline-flex items-center gap-2.5 text-label font-medium uppercase tracking-[0.16em] text-white/80" data-animate>Endereço fiscal e escritórios no Jardim Aquarius</span>
        <h1 class="font-serif text-display-xl leading-[1.12] text-white" data-animate>
          Seu CNPJ com endereço de prestígio no Jardim Aquarius
        </h1>
        <p class="mt-5 max-w-[36rem] text-body-lg text-white/85" data-animate>
          Endereço comercial no Jardim Aquarius para registrar ou transferir o CNPJ da sua empresa,
          com estrutura física de verdade para receber clientes e trabalhar quando precisar.
        </p>

        <div class="hero-price-card mt-7 max-w-[30rem] border border-white/20 bg-white/10 p-5" data-animate>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white/75">
            Endereço Fiscal e Comercial
          </p>
          <div class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-serif text-display-lg leading-none text-white">R$ 119,90</span>
            <span class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-white/70">por mês</span>
          </div>
          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
            {destaquesPreco.map((item) => (
              <li class="inline-flex items-center gap-2 text-[0.78rem] font-medium text-white/85">
                <Icon name="lucide:check" class="h-3.5 w-3.5 flex-shrink-0 text-white" />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row" data-animate>
          <a
            href={WA_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-tracking="click-whatsapp-hero"
            data-section="hero"
            class="btn-primary bg-white text-primary hover:bg-white/90"
          >
            <Icon name="lucide:message-circle" class="h-4 w-4" />
            Quero meu endereço fiscal agora
          </a>
          <a href="tel:+5512982710971" class="btn-ghost border-white text-white hover:bg-white/10">
            <Icon name="lucide:phone" class="h-4 w-4" />
            (12) 98271-0971
          </a>
        </div>
      </div>

    </div>

    <div class="relative mt-9 lg:mt-10" data-animate-scale>
      <Image
        src={heroPrincipal}
        alt="Fachada principal do WeShare - Escritórios Compartilhados"
        class="rounded-lg"
        width={1600}
        height={900}
      />

      <div class="hero-overlay-card surface-card w-full bg-dark/92 p-5 text-white md:absolute md:left-[5%] md:top-[10%] md:w-[20rem] md:border-dark">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white/70">WeShare Escritórios Compartilhados</p>
        <p class="mt-3 text-[0.94rem] leading-6 text-white/92">
          Endereço fiscal, sala de reunião, escritório privativo e estrutura profissional para você atender,
          trabalhar e posicionar melhor a sua empresa.
        </p>
        <div class="mt-4 h-2.5 w-2.5 bg-primary"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .hero-square-card {
    box-shadow: var(--shadow-float);
  }

  .hero-price-card {
    backdrop-filter: blur(2px);
  }

  .hero-overlay-card {
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.18);
  }

  @media (max-width: 767px) {
    .hero-overlay-card {
      margin-top: 1rem;
    }
  }
</style>
